{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["public/**/*.js", "apps/browser-ext/**/*.js"],
      "env": {
        "browser": true,
        "webextensions": true
      },
      "globals": {
        "Auth": "readonly",
        "Dashboard": "readonly",
        "App": "readonly",
        "COUNTRIES": "readonly"
      }
    }
  ]
}
