{
  "name": "porn-blocker-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "package:desktop": "pnpm --filter @pb/desktop-client package",
    "package:android": "pnpm --filter @pb/mobile-client build:android",
    "package:ios": "pnpm --filter @pb/mobile-client build:ios"
  },
  "pnpm": {
    "overrides": {
      "rollup": ">=2.80.0",
      "esbuild": ">=0.25.0",
      "vite": ">=6.4.2",
      "tar-fs": ">=3.1.1",
      "minimatch": ">=9.0.5",
      "ws": ">=8.18.0",
      "form-data": ">=4.0.4",
      "serialize-javascript": ">=6.0.2",
      "path-to-regexp": ">=8.0.0",
      "glob": ">=11.0.0",
      "axios": ">=1.8.2",
      "lodash": ">=4.17.21"
    }
  }
}